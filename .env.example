# Copy to .env. Never commit credentials. Local-only defaults shown here.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-random-secret-before-sharing
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Omit DATABASE_URL for local SQLite. Compose overrides with its PostgreSQL service.
# DATABASE_URL=postgresql://lily:lily-local-only@127.0.0.1:5432/lilyleo
REDIS_URL=redis://127.0.0.1:6379/0
ASSISTANT_TIMEZONE=Asia/Kolkata
DAILY_MODEL_CALL_LIMIT=100
DAILY_INPUT_CHAR_LIMIT=300000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Choose gemini, ollama or freellmapi. Ollama never falls back to cloud.
MODEL_PROVIDER=gemini
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=900
OLLAMA_NUM_CTX=8192
# Optional FreeLLMAPI router. Add your unified key privately to .env, then
# change MODEL_PROVIDER=freellmapi and restart Derek. Requires an existing router.
FREELLMAPI_BASE_URL=http://127.0.0.1:3001/v1
FREELLMAPI_API_KEY=
FREELLMAPI_MODEL=auto:fast
FREELLMAPI_RESEARCH_MODEL=auto:smart
FREELLMAPI_TIMEOUT_SECONDS=120
# Avoid spending short chat output budgets on hidden reasoning. Blank omits
# the hint for a router/model that does not support reasoning_effort.
FREELLMAPI_REASONING_EFFORT=none
# Optional launch of the known .tools/freellmapi-0.16.5 portable desktop app
# for http://127.0.0.1:31415/v1. External/custom routers remain owner-managed.
DEREK_FREELLMAPI_DESKTOP_AUTOSTART=false
# Raise this to 1800 for CPU voice requests that may include a tool result reply.
LILYLEO_TURN_TIMEOUT_SECONDS=120
SEMANTIC_SCHOLAR_API_KEY=
WHISPER_MODEL=base.en
# Desktop voice sessions (microphone closed until explicitly armed).
DEREK_VOICE_SILENCE_MS=900
DEREK_VOICE_IDLE_SECONDS=30
DEREK_VOICE_SESSION_SECONDS=300
DEREK_VOICE_MAX_UTTERANCE_SECONDS=120
DEREK_VOICE_VAD_MODE=2
# Spoken interruption requires headphones; echo cancellation is not included yet.
DEREK_VOICE_BARGE_IN=false
# Optional sounddevice device index or name; blank uses the system defaults.
DEREK_VOICE_INPUT_DEVICE=
DEREK_VOICE_OUTPUT_DEVICE=
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
CARTESIA_MODEL=sonic-3.6
CARTESIA_API_VERSION=2026-08-14
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/v1/calendar/callback/
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Private-chat sender ID; defaults to TELEGRAM_CHAT_ID when omitted.
TELEGRAM_USER_ID=
TELEGRAM_WEBHOOK_SECRET=
# Managed local app receives approved private messages without public HTTPS.
# It refuses to poll while a Telegram webhook is registered.
DEREK_TELEGRAM_POLLING=true
# Desktop companion (device credential created in dashboard Settings)
LILYLEO_API_URL=http://127.0.0.1:8000
LILYLEO_ALLOW_LOCAL_HTTP=true
LILYLEO_DEVICE_TOKEN=
LILYLEO_USER_TOKEN=
LILYLEO_POLL_SECONDS=5
# chromium uses bundled Playwright Chromium; chrome/msedge use the installed vendor browser.
# For Google sign-in, chrome/msedge open a normal manual-login window first.
LILYLEO_BROWSER_CHANNEL=chromium
